# Shared by the production Caddyfile and the local one: what the public site does.
(site) {
	encode zstd gzip

	# Internal endpoints are reachable on the Docker network only: `cms` calls the revalidation
	# route (ADR-0012) and Docker calls the health route. The draft-preview entry belongs to the
	# preview instance, which is tailnet-only (ADR-0001) and is never proxied from here.
	@internal path /internal /internal/* /preview /preview/*
	handle @internal {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy web:3000 {
			health_uri /internal/health
			health_interval 30s
		}
	}
}
