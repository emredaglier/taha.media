# Production Caddy (ADR-0004, ADR-0009). Cloudflare proxies the apex and www, and its SSL mode is
# Full (strict) with a Cloudflare Origin CA certificate mounted at /certs (infra/README.md).
{
	servers {
		# Trust Cloudflare's ranges for the client IP. Refresh from https://www.cloudflare.com/ips/
		# when Cloudflare changes them (rare).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
	# No rate limiting at the origin (ADR-0004).
}

import /etc/caddy/site.caddy

www.taha.media {
	tls /certs/origin.pem /certs/origin.key
	redir https://taha.media{uri} permanent
}

taha.media {
	tls /certs/origin.pem /certs/origin.key
	import site
}
