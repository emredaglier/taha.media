# Copy to .env (git-ignored) and fill in. Never commit real values.

# Path of the SQLite file web reads (read-only). Relative paths resolve against apps/web, so this
# is the file `pnpm --filter @taha/cms dev` creates.
DATABASE_PATH=../cms/data/taha.db

# Must equal PAYLOAD_SECRET in apps/cms/.env.
PAYLOAD_SECRET=
