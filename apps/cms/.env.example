# Copy to .env (git-ignored) and fill in. Never commit real values.

# Path of the SQLite file. Relative paths resolve against the working directory (apps/cms for
# `pnpm dev`). The directory is created if it is missing; it also holds the -wal and -shm files,
# so keep it on a local disk. web opens the same file read-only.
DATABASE_PATH=./data/taha.db

# Signs sessions. Any long random string: `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me

# Optional. "true" pushes the schema straight to the DB on startup (default: only under
# `next dev`). Everything else, including production, uses the committed migrations in
# packages/cms-config/src/migrations (`pnpm --filter @taha/cms migrate`).
# PAYLOAD_DB_PUSH=true

# Comma-separated origins allowed to use the admin API with cookies (CORS and Payload's CSRF
# check), e.g. the tailnet HTTPS URL. REQUIRED when NODE_ENV=production: cms refuses to start
# without it, because an empty list turns the CSRF check off. Optional under `next dev`.
# CMS_ORIGINS=https://cms.your-tailnet.ts.net
