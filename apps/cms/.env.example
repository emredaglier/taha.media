# Copy to .env (git-ignored) and fill in. Never commit real values.

# Path of the SQLite file. Relative paths resolve against the working directory (apps/cms for
# `pnpm dev`). The directory is created if it is missing; it also holds the -wal and -shm files,
# so keep it on a local disk. web opens the same file read-only.
DATABASE_PATH=./data/taha.db

# Signs sessions. Any long random string: `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me

# Optional. "true" pushes the schema straight to the DB on startup (default: only under
# `next dev`). Everything else, including production, uses the committed migrations in
# packages/cms-config/src/migrations (`pnpm --filter @taha/cms migrate`).
# PAYLOAD_DB_PUSH=true

# Comma-separated origins allowed to use the admin API with cookies (CORS and Payload's CSRF
# check), e.g. the tailnet HTTPS URL. REQUIRED when NODE_ENV=production: cms refuses to start
# without it, because an empty list turns the CSRF check off. Optional under `next dev`.
# CMS_ORIGINS=https://cms.your-tailnet.ts.net

# Media (Images). With none of these, uploads stay on local disk next to the database file
# (DATABASE_PATH's folder, "images") and are served by cms at /api/images/file/<name> (dev only).
# Production: MEDIA_ORIGIN (public R2 custom domain, no trailing slash) on cms AND web, and the S3_*
# R2 credentials on cms only. S3_* without MEDIA_ORIGIN refuses to start.
# MEDIA_ORIGIN=https://media.taha.media
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=taha-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Revalidation (ADR-0012). After a publish, unpublish or delete, cms POSTs the affected cache tags
# to web's internal route, over the internal Docker network. REQUIRED when NODE_ENV=production
# (cms, and anything else that writes with the cms config, e.g. the seed in the migrate
# container): without it published changes never reach the prerendered pages. Optional under
# `next dev`, where nothing is sent. REVALIDATE_SECRET must equal web's REVALIDATE_SECRET
# (`openssl rand -hex 32`). A failed POST is logged and never blocks the save.
# REVALIDATE_URL=http://web:3000/internal/revalidate
# REVALIDATE_SECRET=
# REVALIDATE_TIMEOUT_MS=2000

# Preview (ADR-0001). Origin of the preview instance: the same web image started with PREVIEW=1,
# reachable over Tailscale only. With it, the admin shows a preview button on Works and on the
# Site, About and Privacy pages, opening <PREVIEW_URL>/preview?path=<page> (the latest drafts,
# rendered per request, noindex). Without it, no preview button. Must be an http(s) URL.
# PREVIEW_URL=https://preview.your-tailnet.ts.net

# Seeds (run from the repo root, against a migrated database).
# `pnpm seed` fills a LOCAL database with demo content and refuses to run when NODE_ENV or
# TAHA_ENV is "production" or MEDIA_ORIGIN/S3_* are set. Demo login: demo@taha.media /
# demo-password-1234.
# `pnpm seed:production` (once, on the server) creates only the two Editors below, empty Site and
# About pages and a draft Privacy text. Passwords are at least 12 characters.
# SEED_DEVELOPER_EMAIL=
# SEED_DEVELOPER_PASSWORD=
# SEED_TAHA_EMAIL=
# SEED_TAHA_PASSWORD=
# `pnpm user:reset-password <email>` resets an existing Editor (ADR-0013). It reads DATABASE_PATH
# and PAYLOAD_SECRET; the new password is NEW_PASSWORD, or a random one that is printed.
