{
  "name": "@taha/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port 3001",
    "build": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "DATABASE_PATH=${DATABASE_PATH:-./data/codegen.db} PAYLOAD_SECRET=${PAYLOAD_SECRET:-codegen-only-secret} payload generate:types",
    "generate:importmap": "DATABASE_PATH=${DATABASE_PATH:-./data/codegen.db} PAYLOAD_SECRET=${PAYLOAD_SECRET:-codegen-only-secret} payload generate:importmap",
    "migrate": "payload migrate",
    "seed": "payload run scripts/seed.ts --",
    "seed:production": "payload run scripts/seed-production.ts --",
    "user:reset-password": "payload run scripts/reset-password.ts --",
    "migrate:create": "DATABASE_PATH=${DATABASE_PATH:-./data/codegen.db} PAYLOAD_SECRET=${PAYLOAD_SECRET:-codegen-only-secret} payload migrate:create",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@payloadcms/next": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@taha/cms-config": "workspace:*",
    "graphql": "^16.14.2",
    "libsql": "0.4.7",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  }
}
