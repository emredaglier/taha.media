{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["infra", "scripts", "smoke", "vitest.config.ts"],
  // Files of the migrate image: they import ./src/*, which only exists after `pnpm deploy`.
  // scripts/check-shaders is its own project (see its tsconfig.json), checked by `pnpm typecheck`.
  "exclude": ["infra/migrate", "scripts/check-shaders"]
}
